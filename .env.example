# Copy to .env and adjust. Never commit .env.

# --- LLM (optional) -------------------------------------------------------
# Without a key the app runs fully on the rule-based engine.
LLM_PROVIDER=anthropic          # "anthropic" or "none"
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60
LLM_ASSISTED_EXTRACTION=true    # let the LLM fill fields the parser missed (grounded values only)

# --- OCR --------------------------------------------------------------------
OCR_ENGINE=auto                 # auto | rapidocr | tesseract
OCR_RENDER_DPI=200
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Uploads & validation ---------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
ROUNDING_TOLERANCE=1.0

# --- Storage (defaults are inside the project) ------------------------------
# DATABASE_PATH=data/invoices.db
# UPLOAD_DIR=data/uploads
# REPORTS_DIR=reports
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# production refuses to start without API_KEY and hides /docs.
ENVIRONMENT=development
# Required header X-API-Key for /invoices endpoints when set. Use a long random value; never commit it.
API_KEY=
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_EXTRACTIONS=2
EXTRACTION_WAIT_SECONDS=30
MAX_RENDER_MEGAPIXELS=40
# Delete uploads, extracted data and reports after this many days (0 = keep until deleted).
RETENTION_DAYS=30

# --- Frontend ----------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
# The Streamlit app sends API_KEY (above) as X-API-Key.
